# ============================================
# ChromaDB Knowledge Server - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# Required Settings
# ============================================

# Flask secret key (generate a random string)
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-this

# OpenRouter API Key for embeddings
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxx

# ============================================
# Optional Settings (defaults shown)
# ============================================

# Flask environment (development/production)
FLASK_ENV=production

# ChromaDB storage path
CHROMADB_PATH=./data/chromadb

# ChromaDB collection name
CHROMADB_COLLECTION=knowledge_base

# Embedding model (OpenRouter model ID)
EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# Embedding dimensions (must match model output)
EMBEDDING_DIMENSION=4096

# ============================================
# Default Admin Account
# ============================================

# Email of the first system manager account (used to log in)
ADMIN_EMAIL=admin@example.com

# Password for that account. Use a strong password.
# If left empty, a random one-time password is generated and printed to the server log.
ADMIN_PASSWORD=

# ============================================
# External API Access
# ============================================

# Key that external clients send to POST /search and GET /api/stats
# (Authorization: Bearer <key> or X-API-Key header). Leave empty to disable API access.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CHROMADB_API_KEY=

# ============================================
# Alternative: Use Google Gemini (Free!)
# ============================================
# If you prefer Google Gemini API (free tier available):
# GEMINI_API_KEY=your-gemini-api-key
# EMBEDDING_MODEL=text-embedding-004
# EMBEDDING_DIMENSION=768
